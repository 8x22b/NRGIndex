# Скопируй в .env и впиши значения. .env НЕ коммитится.
# Формат ключей: [{"key":"NRG-...-...-...","hash":"sha256...","pid":"sanya"}, ...]
# Хэш считается так: node -e "console.log(require('crypto').createHash('sha256').update('КЛЮЧ').digest('hex'))"
# Поле key нужно только тебе для раздачи; в keys.js попадёт лишь hash+pid.
LOGIN_KEYS_JSON='[]'
OPENROUTER_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
